APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://deploydock:deploydock@localhost:5432/deploydock

# Signs access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypts stored SSH private keys at rest.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=change-me-32-byte-key

# Identifies which key encrypted a stored value. Ciphertext is written as
# "<ENCRYPTION_KEY_ID>:<token>", so the key can be rotated without a manual
# re-encrypt: bump the id, put the OLD key in ENCRYPTION_KEYS_RETIRED, and old
# values keep decrypting while new writes use the new key.
ENCRYPTION_KEY_ID=v1
# Comma-separated "key_id:secret" pairs, still accepted for decryption only.
ENCRYPTION_KEYS_RETIRED=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared login rate limiting. Without this the limiter is per-process, so running
# more than one API worker multiplies the effective limit by the worker count.
# REDIS_URL=redis://127.0.0.1:6379/0
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# Deployment execution limits (seconds).
DEPLOY_TIMEOUT_SECONDS=900
ROLLBACK_TIMEOUT_SECONDS=300
# At startup, deployments still pending/running and older than this are marked
# failed: they belong to a process that is no longer alive.
ORPHAN_DEPLOYMENT_TIMEOUT_SECONDS=3600

# Agents (VPS daemon) — see docs/agent-protocol.md.
HEARTBEAT_INTERVAL_SECONDS=30
# Registration tokens are single-use and expire after this many seconds.
AGENT_REGISTRATION_TOKEN_TTL_SECONDS=900
# An agent whose last heartbeat is older than this shows as offline.
AGENT_OFFLINE_AFTER_SECONDS=90

# Production notes:
# APP_ENV=production
# DATABASE_URL=postgresql+asyncpg://deploydock:<strong-password>@127.0.0.1:5432/deploydock
# SECRET_KEY must be a long random value and must not be "change-me".
# ENCRYPTION_KEY must be a long stable random value. To rotate it, bump
#   ENCRYPTION_KEY_ID and move the old key into ENCRYPTION_KEYS_RETIRED.
# CORS_ORIGINS must be your real frontend origin, for example https://deploydock.example.com.
# REDIS_URL should be set if you run more than one API worker.
