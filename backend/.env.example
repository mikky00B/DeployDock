APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://deploydock:deploydock@localhost:5432/deploydock

# Signs access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypts stored SSH private keys at rest.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=change-me-32-byte-key

# Identifies which key encrypted a stored value. Ciphertext is written as
# "<ENCRYPTION_KEY_ID>:<token>", so the key can be rotated without a manual
# re-encrypt: bump the id, put the OLD key in ENCRYPTION_KEYS_RETIRED, and old
# values keep decrypting while new writes use the new key.
ENCRYPTION_KEY_ID=v1
# Comma-separated "key_id:secret" pairs, still accepted for decryption only.
ENCRYPTION_KEYS_RETIRED=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared login rate limiting. Without this the limiter is per-process, so running
# more than one API worker multiplies the effective limit by the worker count.
# REDIS_URL=redis://127.0.0.1:6379/0
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
# Registration is unauthenticated, so every attempt counts against the source
# address. These limits only work correctly when the client IP is real.
REGISTER_MAX_ATTEMPTS=10
REGISTER_WINDOW_SECONDS=3600
# Set true ONLY behind a reverse proxy you control, so X-Forwarded-For is used
# for rate limiting; leave false when the API is exposed directly, otherwise
# clients can spoof their address.
TRUST_PROXY_HEADERS=false

# Deployment execution limits (seconds).
DEPLOY_TIMEOUT_SECONDS=900
ROLLBACK_TIMEOUT_SECONDS=300
# At startup, deployments still pending/running and older than this are marked
# failed: they belong to a process that is no longer alive.
ORPHAN_DEPLOYMENT_TIMEOUT_SECONDS=3600

# Agents (VPS daemon) — see docs/agent-protocol.md.
HEARTBEAT_INTERVAL_SECONDS=30
# Registration tokens are single-use and expire after this many seconds.
AGENT_REGISTRATION_TOKEN_TTL_SECONDS=900
# An agent whose last heartbeat is older than this shows as offline.
AGENT_OFFLINE_AFTER_SECONDS=90
# A claimed agent command older than this is assumed lost (agent died
# mid-deploy): the sweep fails it and its deployment so the app is not
# blocked. Must exceed the longest legitimate deploy (DEPLOY_TIMEOUT_SECONDS).
AGENT_COMMAND_LEASE_SECONDS=1800
# How often the expired-lease sweep runs while the API is live.
AGENT_RECLAIM_SWEEP_SECONDS=300

# --- Email (SMTP) ---
# With SMTP_HOST unset, email is disabled: no signup codes are sent, accounts
# are created already verified, and deployment notifications are dropped.
# Example (Namecheap/Titan): SMTP_HOST=smtp.titan.email, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=DeployDock
# Public dashboard URL used in email bodies.
APP_PUBLIC_URL=http://127.0.0.1:5173
# When true, a fresh account cannot be used until it confirms the emailed
# 6-digit code (requires SMTP_HOST). Keep false in local development.
REQUIRE_EMAIL_VERIFICATION=false
# Email the owner when a deployment succeeds or fails.
EMAIL_NOTIFICATIONS_ENABLED=true
# Verification codes expire after this many seconds and burn after this many
# wrong attempts (a fresh code must then be requested).
EMAIL_CODE_TTL_SECONDS=900
EMAIL_CODE_MAX_ATTEMPTS=5

# Production notes:
# APP_ENV=production
# DATABASE_URL=postgresql+asyncpg://deploydock:<strong-password>@127.0.0.1:5432/deploydock
# SECRET_KEY must be a long random value and must not be "change-me".
# ENCRYPTION_KEY must be a long stable random value. To rotate it, bump
#   ENCRYPTION_KEY_ID and move the old key into ENCRYPTION_KEYS_RETIRED.
# CORS_ORIGINS must be your real frontend origin, for example https://deploydock.example.com.
# REDIS_URL should be set if you run more than one API worker.
