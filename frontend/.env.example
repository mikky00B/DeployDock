# Dev default: leave unset so the dashboard calls the API same-origin and Vite
# proxies /api to 127.0.0.1:8000 (see vite.config.ts server.proxy).
#
# Set an absolute URL only when the API lives on a different origin — Vite
# inlines it at build time, so changing it requires a dev-server restart or a
# rebuild.
#
# Production example:
# VITE_API_BASE_URL=https://deploydock.example.com
